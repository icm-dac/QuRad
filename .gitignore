# Author-only working material: manuscript, figure sources, submission package, paper build
internal/
site/
CLAUDE.md
.claude/

# Large source images. The notebooks run from the feature tables, not the pixels;
# ship these through Zenodo rather than git.
*.ndpi
example_data/puma_subset/*.tif
example_data/puma_subset/*_nuclei.geojson
example_data/puma_subset/*_tissue.geojson
example_data/tiger_subset/*.tif
# TIGER annotation files: dataset-provider terms apply; not redistributed here until cleared
example_data/tiger_subset/*.xml
example_data/tiger_subset/*.geojson

# PyRadiomics comparison intermediates: the PUMA masks and grayscale images are large and are
# regenerated by the headless runner; the feature tables next to them are kept.
example_data/puma_subset/pyradiomics/*/masks/
example_data/puma_subset/pyradiomics/*/gray.png
notebooks/results/tables/*_pooled.csv

# Build output and caches
extension/build/
extension/.gradle/
__pycache__/
*.aux
*.bcf
*.blg
*.out
*.run.xml
*.synctex.gz

# notebook run logs
notebooks/results/ml/*.log
